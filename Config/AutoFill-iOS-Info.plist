<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ASCredentialProviderExtensionCapabilities</key>
	<dict>
		<key>ProvidesPasskeys</key>
		<true/>
		<key>ProvidesPasswords</key>
		<true/>
		<key>ShowsConfigurationUI</key>
		<true/>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>Proximus AutoFill</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Proximus AutoFill</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>ASCredentialProviderExtensionCapabilities</key>
			<dict>
				<key>ProvidesPasskeys</key>
				<true/>
				<key>ProvidesPasswords</key>
				<true/>
				<key>ShowsConfigurationUI</key>
				<true/>
			</dict>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.authentication-services-credential-provider-ui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).CredentialProviderViewController</string>
	</dict>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock your vault, approve passkeys, and reveal wallet recovery details.</string>
	<key>ProximusAppGroup</key>
	<string>$(PROXIMUS_APP_GROUP)</string>
	<key>ProximusKeychainGroup</key>
	<string>$(PROXIMUS_KEYCHAIN_GROUP)</string>
	<key>ProximusSigningTeam</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>ProximusSourceDirty</key>
	<string>$(PROXIMUS_SOURCE_DIRTY)</string>
	<key>ProximusSourceRevision</key>
	<string>$(PROXIMUS_SOURCE_REVISION)</string>
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk.ttf</string>
		<string>Sora.ttf</string>
	</array>
</dict>
</plist>
