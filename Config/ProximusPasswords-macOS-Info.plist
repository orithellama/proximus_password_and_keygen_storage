<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ASCredentialProviderExtensionCapabilities</key>
	<dict>
		<key>ProvidesPasskeys</key>
		<true/>
		<key>ProvidesPasswords</key>
		<true/>
		<key>ShowsConfigurationUI</key>
		<true/>
	</dict>
	<key>CFBundleDisplayName</key>
	<string>Proximus</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Proximus</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.proximus.passwords.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>proximus</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_proximus-pair._tcp</string>
		<string>_proximus-sync._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan a Proximus device pairing QR code. Camera images are not stored or uploaded.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to unlock your vault, reveal or copy saved credentials, approve passkeys, and reveal wallet recovery details.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Pair and sync your encrypted Proximus vault with nearby devices you approve.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>ProximusAppGroup</key>
	<string>$(PROXIMUS_APP_GROUP)</string>
	<key>ProximusKeychainGroup</key>
	<string>$(PROXIMUS_KEYCHAIN_GROUP)</string>
	<key>ProximusSigningTeam</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>ProximusSourceDirty</key>
	<string>$(PROXIMUS_SOURCE_DIRTY)</string>
	<key>ProximusSourceRevision</key>
	<string>$(PROXIMUS_SOURCE_REVISION)</string>
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk.ttf</string>
		<string>Sora.ttf</string>
	</array>
</dict>
</plist>
